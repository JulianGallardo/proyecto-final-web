// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  agente
  mesa_de_entrada
  jefatura
}

model User {
  id       String    @id @default(cuid())
  name     String?
  lastname String?
  email    String    @unique
  password String?
  telefono BigInt?
  accounts Account[]
  role     Role      @default(agente)
  agente   Agente?
  User     Token[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Token {
  id String @id @default(cuid())
  
  hashedToken String
  expiration DateTime
  userId String
  User User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agente {
  id                  Int                   @id @default(autoincrement())
  userId              String                @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  zonas               Zone[]
  EntregaInstrumentos EntregaInstrumentos[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EstadoEntrega {
  PENDIENTE_DE_PROCESAR
  NOTIFICADO
  NO_NOTIFICADO
}

model EntregaInstrumentos {
  id            Int         @id @default(autoincrement())
  agenteId      Int?
  agente        Agente?      @relation(fields: [agenteId], references: [id])
  agenteFullName    String
  instrumentoId String
  instrumento   Instrumento @relation(fields: [instrumentoId], references: [codigoInstrumento], onDelete: Cascade)

  estado EstadoEntrega @default(PENDIENTE_DE_PROCESAR)

  observaciones String?

  fecha_entrega DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Coordinates {
  id                   String @id @default(cuid())
  geometryAssociatedId String
  latitude             Float
  longitude            Float

  Geometry Geometry @relation(fields: [geometryAssociatedId], references: [id], onDelete: Cascade) // Cascade en relación con Geometry

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Geometry {
  id          String        @id @default(cuid())
  type        String
  coordinates Coordinates[] // Relación con Coordinates
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  zone        Zone?
  subZone     SubZone?
}

model Zone {
  id        String @id @default(cuid())
  zoneName  String @unique
  zoneColor String
  type      String @default("Feature")

  geometryId   String        @unique
  geometry     Geometry      @relation(fields: [geometryId], references: [id], onDelete: Cascade) // Cascade en relación con Geometry
  Agentes      Agente[]
  Instrumentos Instrumento[]
  SubZonas     SubZone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubZone {
  id        String @id @default(cuid())
  zoneName  String 
  type      String @default("Feature")

  geometryId   String        @unique
  geometry     Geometry      @relation(fields: [geometryId], references: [id], onDelete: Cascade) // Cascade en relación con Geometry

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zonaId String
  Zona      Zone? @relation(fields: [zonaId], references: [id])
}


model Juzgado {
  id         Int    @id @default(autoincrement())
  name       String
  identifier String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  OrdenId Orden[]
}

model InstrumentoType {
  id           Int           @id @default(autoincrement())
  name         String
  identifier   String        @unique
  Instrumentos Instrumento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Orden {
  id          Int          @id @default(autoincrement())
  ordenNumber Int
  juzgadoId   Int
  juzgado     Juzgado      @relation(fields: [juzgadoId], references: [id], onDelete: Cascade)
  instrumento Instrumento?
}

enum TipoCarga {
  PDF
  MAN
}

enum EstadoInstrumento {
  CORRECCIONES_SOLICITADAS
  PENDIENTE_DE_NOTIFICAR
  PENDIENTE_DE_PROCESAR_NOTIFICACION
  NOTIFICADO_VERDE
  NOTIFICADO_AMARILLO
  NOTIFICADO_ROJO
}

enum UrgenciaInstrumento {
  NORMAL
  URGENTE
}

enum SubZona {
  A
  B
  C
  D
  Sin_SubZona
}

model Instrumento {
  codigoInstrumento String    @unique
  cargaInstrumento  TipoCarga
  ordenId           Int       @unique
  orden             Orden     @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  fecha_de_ingreso DateTime  @default(now())
  fecha_de_salida  DateTime?

  observaciones String?

  caratula             String
  domicilio_denunciado String

  instrumentoTypeId Int
  instrumentoType   InstrumentoType @relation(fields: [instrumentoTypeId], references: [id], onDelete: Cascade)

  HistorialEntregas EntregaInstrumentos[]

  estado EstadoInstrumento @default(PENDIENTE_DE_NOTIFICAR)

  urgencia UrgenciaInstrumento @default(NORMAL)

  zoneName String?
  Zona     Zone?   @relation(fields: [zoneName], references: [zoneName])
  subZona  SubZona @default(Sin_SubZona)

  latitude  Float?
  longitude Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([cargaInstrumento, codigoInstrumento, ordenId])
}
