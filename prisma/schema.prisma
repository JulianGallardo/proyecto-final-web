// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  user
  admin
}

model User {
  id       String    @id @default(cuid())
  name     String?
  email    String    @unique
  password String?
  image    String?
  accounts Account[]
  role     Role      @default(user)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Coordinates {
  id                   String @id @default(cuid())
  geometryAssociatedId String
  latitude             Float
  longitude            Float

  Geometry Geometry @relation(fields: [geometryAssociatedId], references: [id], onDelete: Cascade) // Cascade en relación con Geometry

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Geometry {
  id          String        @id @default(cuid())
  type        String
  coordinates Coordinates[] // Relación con Coordinates
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  zone        Zone?
}

model Zone {
  id        String @id @default(cuid())
  zoneName  String @unique
  zoneColor String
  type      String @default("Feature")

  geometryId String   @unique
  geometry   Geometry @relation(fields: [geometryId], references: [id], onDelete: Cascade) // Cascade en relación con Geometry

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Juzgado {
  id           Int           @id @default(autoincrement())
  name         String
  identifier   String        @unique
  Instrumentos Instrumento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstrumentoType {
  id           Int           @id @default(autoincrement())
  name         String
  identifier   String        @unique
  Instrumentos Instrumento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Instrumento {
  entryDate DateTime  @default(now())
  exitDate  DateTime?

  caratula     String
  destinatario String

  address     String //destinatario postal
  ordenNumber Int

  juzgadoId         Int
  instrumentoTypeId Int

  juzgado         Juzgado         @relation(fields: [juzgadoId], references: [id], onDelete: Cascade)
  instrumentoType InstrumentoType @relation(fields: [instrumentoTypeId], references: [id], onDelete: Cascade)

  deleted Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@id([juzgadoId, ordenNumber])
}
